{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trading-journal",
  "main": "functions/worker.ts",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trade-diary-db",
      "database_id": "fa17767d-ceb0-4626-a9ca-a4136259c023"
    }
  ]
}
